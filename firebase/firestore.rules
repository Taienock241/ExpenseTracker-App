rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'displayName', 'email', 'currency', 'setupVersion', 'createdAt'
        ])
        && data.keys().hasAll([
          'displayName', 'email', 'currency', 'setupVersion', 'createdAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.currency == 'KES'
        && data.setupVersion is int
        && data.setupVersion in [0, 1]
        && data.createdAt is timestamp;
    }

    function validCategory(data) {
      return data.keys().hasOnly([
          'name', 'type', 'iconKey', 'colorHex', 'builtIn', 'archived', 'sortOrder', 'createdAt'
        ])
        && data.keys().hasAll([
          'name', 'type', 'iconKey', 'colorHex', 'builtIn', 'archived', 'sortOrder', 'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 30
        && data.type in ['INCOME', 'EXPENSE']
        && data.iconKey is string
        && data.colorHex is string
        && data.colorHex.matches('^#[0-9A-Fa-f]{6}$')
        && data.builtIn is bool
        && data.archived is bool
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.createdAt is timestamp;
    }

    function validAccount(data) {
      return data.keys().hasOnly([
          'name', 'type', 'openingBalanceMinor', 'archived', 'createdAt'
        ])
        && data.keys().hasAll([
          'name', 'type', 'openingBalanceMinor', 'archived', 'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 30
        && data.type in ['CASH', 'BANK', 'MPESA', 'OTHER']
        && data.openingBalanceMinor is int
        && data.openingBalanceMinor >= 0
        && data.archived is bool
        && data.createdAt is timestamp;
    }

    function validTransaction(data) {
      return data.keys().hasOnly([
          'title', 'type', 'amountMinor', 'categoryId', 'accountId', 'occurredAt', 'notes', 'createdAt'
        ])
        && data.keys().hasAll([
          'title', 'type', 'amountMinor', 'categoryId', 'accountId', 'occurredAt', 'notes', 'createdAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.type in ['INCOME', 'EXPENSE']
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.categoryId is string
        && data.accountId is string
        && data.occurredAt is timestamp
        && data.notes is string
        && data.notes.size() <= 500
        && data.createdAt is timestamp;
    }

    function validBudget(data) {
      return data.keys().hasOnly(['month', 'categoryId', 'amountLimitMinor', 'createdAt'])
        && data.keys().hasAll(['month', 'categoryId', 'amountLimitMinor', 'createdAt'])
        && data.month is string
        && data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.categoryId is string
        && data.amountLimitMinor is int
        && data.amountLimitMinor > 0
        && data.createdAt is timestamp;
    }

    function validGoal(data) {
      return data.keys().hasOnly(['name', 'targetMinor', 'savedMinor', 'targetDate', 'archived', 'createdAt'])
        && data.keys().hasAll(['name', 'targetMinor', 'savedMinor', 'targetDate', 'archived', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.targetMinor is int
        && data.targetMinor > 0
        && data.savedMinor is int
        && data.savedMinor >= 0
        && data.targetDate is timestamp
        && data.archived is bool
        && data.createdAt is timestamp;
    }

    function validRecurring(data) {
      return data.keys().hasOnly([
          'title', 'type', 'amountMinor', 'categoryId', 'accountId', 'frequency', 'nextDueAt', 'active', 'createdAt'
        ])
        && data.keys().hasAll([
          'title', 'type', 'amountMinor', 'categoryId', 'accountId', 'frequency', 'nextDueAt', 'active', 'createdAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.type in ['INCOME', 'EXPENSE']
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.categoryId is string
        && data.accountId is string
        && data.frequency in ['WEEKLY', 'MONTHLY', 'YEARLY']
        && data.nextDueAt is timestamp
        && data.active is bool
        && data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if ownsUser(uid);
      allow create: if ownsUser(uid) && validUserProfile(request.resource.data);
      allow update: if ownsUser(uid)
        && validUserProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /categories/{categoryId} {
        allow read: if ownsUser(uid);
        allow create, update: if ownsUser(uid) && validCategory(request.resource.data);
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow read: if ownsUser(uid);
        allow create, update: if ownsUser(uid) && validAccount(request.resource.data);
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read: if ownsUser(uid);
        allow create, update: if ownsUser(uid) && validTransaction(request.resource.data);
        allow delete: if ownsUser(uid);
      }

      match /budgets/{budgetId} {
        allow read: if ownsUser(uid);
        allow create, update: if ownsUser(uid) && validBudget(request.resource.data);
        allow delete: if false;
      }

      match /goals/{goalId} {
        allow read: if ownsUser(uid);
        allow create, update: if ownsUser(uid) && validGoal(request.resource.data);
        allow delete: if false;
      }

      match /recurring/{recurringId} {
        allow read: if ownsUser(uid);
        allow create, update: if ownsUser(uid) && validRecurring(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
