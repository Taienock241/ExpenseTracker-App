<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <!-- Error state (AuthField.error sets isActivated) -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coral_soft" />
            <stroke android:width="1.5dp" android:color="@color/coral" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/forest_600" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/green_50" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
