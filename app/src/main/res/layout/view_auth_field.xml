<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/authFieldLabel"
        style="@style/Widget.Auth.Label" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/authFieldInput"
            style="@style/Widget.Auth.Input"
            android:importantForAutofill="yes" />

        <ImageButton
            android:id="@+id/authFieldToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_visibility"
            android:tint="@color/text_muted"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/authFieldError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/coral"
        android:textSize="12sp"
        android:visibility="gone" />
</merge>
