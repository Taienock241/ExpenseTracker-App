<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_horizontal_padding"
            android:paddingTop="64dp"
            android:paddingEnd="@dimen/auth_horizontal_padding"
            android:paddingBottom="32dp">

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthHeader
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:headerSubtitle="@string/register_subtitle"
                app:headerTitle="@string/register_title" />

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthField
                android:id="@+id/firstNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_first_name"
                android:inputType="textPersonName|textCapWords"
                app:fieldLabel="@string/label_first_name" />

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthField
                android:id="@+id/lastNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="@string/hint_last_name"
                android:inputType="textPersonName|textCapWords"
                app:fieldLabel="@string/label_last_name" />

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthField
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                app:fieldLabel="@string/login_email_label" />

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthField
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="@string/hint_create_password"
                android:inputType="textPassword"
                app:fieldLabel="@string/login_password_label" />

            <com.example.pesatrackexpensetrackapp.ui.auth.PasswordRequirementsView
                android:id="@+id/passwordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="8dp" />

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthField
                android:id="@+id/confirmPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/hint_confirm_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                app:fieldLabel="@string/label_confirm_password" />

            <TextView
                android:id="@+id/messageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/coral"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/createAccountActionButton"
                    style="@style/Widget.Auth.PrimaryButton"
                    android:text="@string/action_sign_up" />

                <ProgressBar
                    android:id="@+id/loadingIndicator"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:elevation="8dp"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prompt_has_account"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/signInButton"
                    style="@style/Widget.Auth.LinkButton"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/action_login" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.Auth.LinkButton"
            android:layout_gravity="top|start"
            android:layout_marginTop="8dp"
            android:text="@string/action_back"
            android:textColor="@color/text_muted" />
    </FrameLayout>
</ScrollView>
