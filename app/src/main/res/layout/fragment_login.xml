<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <!-- Content is centred vertically on tall screens and scrolls when the keyboard or a small screen needs it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_horizontal_padding"
            android:paddingTop="64dp"
            android:paddingEnd="@dimen/auth_horizontal_padding"
            android:paddingBottom="32dp">

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthHeader
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:headerSubtitle="@string/login_subtitle"
                app:headerTitle="@string/login_title" />

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthField
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                app:fieldLabel="@string/login_email_label" />

            <com.example.pesatrackexpensetrackapp.ui.auth.AuthField
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="@string/hint_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                app:fieldLabel="@string/login_password_label" />

            <Button
                android:id="@+id/forgotPasswordButton"
                style="@style/Widget.Auth.LinkButton"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="@string/action_forgot_password" />

            <TextView
                android:id="@+id/messageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textColor="@color/coral"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/signInActionButton"
                    style="@style/Widget.Auth.PrimaryButton"
                    android:text="@string/action_sign_in" />

                <ProgressBar
                    android:id="@+id/loadingIndicator"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:elevation="8dp"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <Button
                android:id="@+id/biometricButton"
                style="@style/Widget.Auth.SecondaryButton"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_fingerprint"
                android:text="@string/action_sign_in_fingerprint"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prompt_no_account"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/registerButton"
                    style="@style/Widget.Auth.LinkButton"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/action_register" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.Auth.LinkButton"
            android:layout_gravity="top|start"
            android:layout_marginTop="8dp"
            android:text="@string/action_back"
            android:textColor="@color/text_muted" />
    </FrameLayout>
</ScrollView>
