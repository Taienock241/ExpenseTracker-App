<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mainNavHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main" />

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <Button
            android:id="@+id/navHomeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="@string/nav_dashboard"
            android:textAllCaps="false"
            android:textColor="@color/forest_700"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navTransactionsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="@string/nav_transactions"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navBudgetsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="@string/nav_budgets"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navReportsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="@string/nav_reports"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navMoreButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:text="@string/nav_more"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
